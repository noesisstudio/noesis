# Copia este archivo a ".env" y rellena tu clave.
# Se saca en https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Sonnet es más barato/rápido (ideal para el prototipo).
# Para máxima calidad: claude-opus-4-8
NOESIS_MODEL=claude-sonnet-4-6
# Declara la tarifa vigente si este modelo se usa directamente; cero = desconocida.
NOESIS_MODEL_INPUT_USD_PER_MTOK=0
NOESIS_MODEL_OUTPUT_USD_PER_MTOK=0
# Modelo barato usado cuando el cerebro local no resuelve una consulta. Sin sufijo
# de fecha: una versión fechada puede dejar de resolverse y toda llamada daría 404.
NOESIS_FALLBACK_MODEL=claude-haiku-4-5
# Coste por millón de tokens del modelo anterior. Actualízalo si cambias de modelo.
NOESIS_FALLBACK_INPUT_USD_PER_MTOK=1
NOESIS_FALLBACK_OUTPUT_USD_PER_MTOK=5

# Revisión y aprendizaje supervisado: candidatos apagados; validar antes del piloto.
NOESIS_ASSISTANT_REVIEW_ENABLED=false
NOESIS_ASSISTANT_LEARNING_ENABLED=false
# Piloto local de líneas/correcciones. Exige también ASSISTANT_REVIEW_ENABLED.
# No activa modelos, proveedores externos ni aprendizaje.
NOESIS_LOCAL_PLANNER_ENABLED=false

# --- IA privada/local opcional ---
# Bynoesis intenta: reglas internas -> este servicio privado -> IA externa consentida.
# Compatible con Ollama, llama.cpp y vLLM mediante /v1/chat/completions.
NOESIS_LOCAL_AI_BASE_URL=
NOESIS_LOCAL_AI_MODEL=
NOESIS_LOCAL_AI_API_KEY=
NOESIS_LOCAL_AI_TIMEOUT_SECONDS=45

# --- IA externa OpenAI-compatible opcional ---
# Se intenta después de la IA privada y antes de Anthropic. Requiere consentimiento
# del negocio y consume un crédito del plan. Ejemplo Groq (no prometas el free tier
# en producción; configura facturación/límite y valida el modelo con el corpus real):
# NOESIS_COMPAT_AI_BASE_URL=https://api.groq.com/openai/v1
# NOESIS_COMPAT_AI_MODEL=qwen/qwen3-32b
# NOESIS_COMPAT_AI_PROVIDER=groq
# NOESIS_COMPAT_AI_LEGAL_NAME=Groq, Inc.
# NOESIS_COMPAT_AI_REGION=EE. UU. (cláusulas contractuales tipo)
# NOESIS_COMPAT_AI_INPUT_USD_PER_MTOK=0.29
# NOESIS_COMPAT_AI_OUTPUT_USD_PER_MTOK=0.59
NOESIS_COMPAT_AI_BASE_URL=
NOESIS_COMPAT_AI_MODEL=
NOESIS_COMPAT_AI_API_KEY=
NOESIS_COMPAT_AI_PROVIDER=compatible
NOESIS_COMPAT_AI_LEGAL_NAME=
NOESIS_COMPAT_AI_REGION=
NOESIS_COMPAT_AI_TIMEOUT_SECONDS=45
NOESIS_COMPAT_AI_INPUT_USD_PER_MTOK=0
NOESIS_COMPAT_AI_OUTPUT_USD_PER_MTOK=0

# Nombre del negocio del autónomo (se usa en las facturas de prueba)
NOESIS_BUSINESS_NAME=Mi Negocio

# --- Seguridad / despliegue ---
# Clave para firmar sesiones (OBLIGATORIA en producción). Genera una larga y aleatoria.
NOESIS_SECRET=cambia-esto-por-algo-largo-y-aleatorio
NOESIS_ENV=production
# Railway aporta RAILWAY_GIT_COMMIT_SHA. En otro proveedor puede fijarse una
# referencia publica (SHA o version), nunca un secreto.
NOESIS_RELEASE_ID=
NOESIS_HTTPS=true
# Railway ya activa confianza en proxy. Fuera de Railway, habilítala solo si hay
# un proxy controlado y ajusta el número de saltos desde la derecha.
NOESIS_TRUST_PROXY_HEADERS=false
NOESIS_PROXY_HOPS=1
# URL pública canónica (para emails, portales, OAuth y vueltas de Stripe).
NOESIS_BASE_URL=https://bynoesis.com
NOESIS_CANONICAL_PUBLIC_HOST=bynoesis.com
# Hosts aceptados por la aplicación, separados por comas. El dominio de BASE_URL,
# localhost y el dominio privado de Railway se añaden automáticamente.
NOESIS_ALLOWED_HOSTS=bynoesis.com,www.bynoesis.com
# Identidad legal. El alta pública queda cerrada en producción hasta completar los
# cuatro campos mínimos y habilitarla de forma explícita.
NOESIS_LEGAL_NAME=
NOESIS_LEGAL_NIF=
NOESIS_LEGAL_ADDRESS=
NOESIS_LEGAL_EMAIL=
# Obligatorio si el titular es una sociedad: Registro Mercantil, tomo, folio, hoja.
NOESIS_LEGAL_REGISTRY=
# Fecha (AAAA-MM-DD) de los textos legales; cambiarla al cambiar de titular.
NOESIS_LEGAL_DOCUMENT_VERSION=
NOESIS_CONTACT_EMAIL=noesisstudioo@gmail.com
NOESIS_SMTP_PROVIDER_NAME=
NOESIS_SMTP_PROVIDER_REGION=
NOESIS_PUBLIC_SIGNUP_ENABLED=false
# ID de Google Analytics 4 (G-XXXXXXX). Vacío: sin aviso de cookies ni Google.
# Con valor, la web pública pide permiso y solo carga Google tras «Aceptar».
NOESIS_GA_MEASUREMENT_ID=
# Vídeo de /bienvenida: ID o enlace de YouTube (mejor «oculto»). Vacío: sin vídeo.
# YouTube solo se conecta cuando el cliente pulsa «Ver el vídeo».
NOESIS_WELCOME_VIDEO_ID=
# Correos con acceso al panel /admin. Admite varios separados por coma.
NOESIS_ADMIN_EMAIL=xavier@bynoesis.com,miquel@bynoesis.com
# Buzón donde llegan las solicitudes de acceso del formulario público. Tiene su
# propia variable porque quien las atiende no tiene por qué ser quien administra.
NOESIS_REQUESTS_EMAIL=info@bynoesis.com
# Caducidad por inactividad. El administrador usa una ventana más corta.
NOESIS_SESSION_IDLE_MINUTES=720
NOESIS_ADMIN_SESSION_IDLE_MINUTES=60
# En producción exige Google OAuth para /admin si Google está configurado.
NOESIS_ADMIN_REQUIRE_GOOGLE_OAUTH=true
# Registro JSON mínimo de peticiones, sin query strings ni datos personales.
NOESIS_LOG_REQUESTS=true
# Días de prueba gratuita al darse de alta.
NOESIS_TRIAL_DAYS=14
# Demo y borrado están desactivados por defecto. No actives RESET en producción.
NOESIS_SEED_DEMO=false
NOESIS_RESET_DB=false

# --- Acceso con Google (OAuth 2.0, opcional) ---
# Crea un cliente web en Google Cloud y registra exactamente:
# https://bynoesis.com/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- WhatsApp (Meta Cloud API) ---
NOESIS_WHATSAPP_NUMBER=+34XXXXXXXXX
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
# Secreto de la aplicación Meta: firma cada webhook entrante.
WHATSAPP_APP_SECRET=
# Mantener actualizado según el ciclo de versiones de Meta.
META_GRAPH_VERSION=v23.0
WHATSAPP_RETRY_BASE_SECONDS=30
WHATSAPP_RETRY_MAX_SECONDS=3600
WHATSAPP_MAX_ATTEMPTS=6
# Deben coincidir exactamente con plantillas aprobadas en Meta Business.
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_DAILY_SUMMARY=bynoesis_resumen_diario
WHATSAPP_TEMPLATE_WEEKLY_SUMMARY=bynoesis_resumen_semanal
WHATSAPP_TEMPLATE_PAYMENT_ALERT=bynoesis_aviso_cobros
# Parámetros: cliente, negocio, número de factura, importe restante, URL del portal.
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=bynoesis_recordatorio_cobro
WHATSAPP_TEMPLATE_INVOICE=bynoesis_factura_lista
# Parámetros: cliente, negocio, número de presupuesto, importe, URL del portal.
WHATSAPP_TEMPLATE_QUOTE_FOLLOWUP=bynoesis_seguimiento_presupuesto
# Parámetros: cliente, negocio, fecha/hora y descripción del trabajo.
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=bynoesis_recordatorio_cita
# Parámetros: un solo cuerpo de texto (resumen del cierre del día).
WHATSAPP_TEMPLATE_DAILY_CLOSING=bynoesis_cierre_dia
# Parámetros: un solo cuerpo de texto (aviso fiscal trimestral 303/130).
WHATSAPP_TEMPLATE_TAX_NOTICE=bynoesis_aviso_fiscal

# --- Facebook (promoción de Noesis, no es parte del producto) ---
# Solo lo usa la automatización de facebook/. En producción no hace
# falta: en GitHub Actions estos valores llegan como secretos del repositorio.
# Se obtienen con: python facebook/conectar.py
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Opcionales: permiten avisar de la caducidad del token antes de que pare.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Transcripción de notas de voz vía API (Groq; validar tarifa vigente). ---
# Si falta la clave, se intenta faster-whisper local; si tampoco está, se pide texto.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Vacío detecta automáticamente catalán/castellano/inglés. Solo fija ca/es/en si
# todo el audio de ese despliegue tiene un único idioma conocido.
NOESIS_WHISPER_LANGUAGE=
# Tope diario de extracciones IA (fotos/PDF) por negocio: protege el margen.
NOESIS_MAX_DAILY_EXTRACTIONS=30

# --- Email (reset de contraseña y avisos). Si se deja vacío, se registra en log. ---
# Vía preferida: API por HTTPS. OBLIGATORIA en Railway y plataformas parecidas,
# que bloquean la salida a los puertos de SMTP para evitar el envío de spam. Con
# clave se usa esta; sin ella se cae al SMTP de abajo.
BREVO_API_KEY=
# El remitente (SMTP_FROM) debe estar verificado en el proveedor o rechazará el
# envío; verificar el dominio entero además evita que caiga en spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bynoesis <no-reply@bynoesis.com>
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600

# --- Cobro de suscripción (Stripe). Vacío = alta en prueba manual. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUTONOMO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_AUTONOMO_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
# Los precios públicos son base imponible (+ IVA): mantener activo en producción.
NOESIS_STRIPE_AUTOMATIC_TAX=true

# --- Veri*Factu nativo (registro/QR/XML y remisión AEAT opcional) ---
# NIF real del productor del software. Es obligatorio para activar el modo.
NOESIS_VERIFACTU_PRODUCER_NAME=Bynoesis
NOESIS_VERIFACTU_PRODUCER_NIF=
NOESIS_VERIFACTU_SYSTEM_NAME=Bynoesis
NOESIS_VERIFACTU_SYSTEM_ID=NO
NOESIS_VERIFACTU_SYSTEM_VERSION=0.1.0
NOESIS_VERIFACTU_INSTALLATION_PREFIX=noesis
# Valores oficiales vigentes; configurables para futuras revisiones de la AEAT.
NOESIS_VERIFACTU_HASH_ALGORITHM=sha256
NOESIS_VERIFACTU_HASH_TYPE=01
NOESIS_VERIFACTU_HASH_SPEC_VERSION=0.1.2
NOESIS_VERIFACTU_RECORD_VERSION=1.0
NOESIS_VERIFACTU_QR_BASE_URL=https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ValidarQR
# Remisión SOAP con certificado PEM. Las tres vacías = totalmente desactivada.
# Usa "pruebas" hasta validar el certificado y las respuestas de la AEAT.
VERIFACTU_CERT_PATH=
VERIFACTU_KEY_PATH=
# Opcional si la clave PEM está cifrada. Guardar como secreto, nunca en Git.
VERIFACTU_KEY_PASSWORD=
# persona = certificado ordinario; sello = certificado de sello electrónico.
VERIFACTU_CERT_TYPE=persona
VERIFACTU_AEAT_ENV=
NOESIS_VERIFACTU_HTTP_TIMEOUT_SECONDS=30
NOESIS_VERIFACTU_RETRY_BASE_SECONDS=30
NOESIS_VERIFACTU_RETRY_MAX_SECONDS=3600
NOESIS_VERIFACTU_MAX_ATTEMPTS=6
NOESIS_VERIFACTU_MAX_RESPONSE_BYTES=2097152

# --- Audio de WhatsApp (notas de voz -> texto -> acción) ---
# Bynoesis puede transcribir las notas de voz EN LOCAL con faster-whisper (sin coste por uso;
# la voz no gasta tokens de IA). Es dependencia OPCIONAL para no cargar RAM si no se
# usa. Para activarla:   pip install -e ".[audio]"
# Modelo: tiny (rápido, ~1 GB RAM) o base (mejor, ~2 GB). Sube el plan de Railway si
# hace falta más memoria. Si NO instalas el extra, el audio se ignora y se pide texto.
NOESIS_WHISPER_MODEL=tiny
# Carpeta donde cachear el modelo descargado (en producción, un volumen persistente).
NOESIS_WHISPER_DIR=/data/models

# --- Persistencia y límites ---
# Railway: referencia la variable del servicio Postgres, por ejemplo
# DATABASE_URL=${{Postgres.DATABASE_URL}}. Vacía = SQLite local.
DATABASE_URL=
# Solo se usa como fallback cuando DATABASE_URL está vacía.
NOESIS_DB_PATH=/data/noesis.db
NOESIS_BACKUP_DIR=/backups
# Opcional: copia externa S3-compatible. Si las credenciales quedan vacías no se
# realiza ninguna subida; si se configuran, proveedor y regiones son obligatorios.
NOESIS_BACKUP_S3_ENDPOINT=
NOESIS_BACKUP_S3_BUCKET=
NOESIS_BACKUP_S3_ACCESS_KEY=
NOESIS_BACKUP_S3_SECRET_KEY=
NOESIS_BACKUP_S3_REGION=
NOESIS_BACKUP_S3_PROVIDER_NAME=
NOESIS_BACKUP_S3_DATA_REGION=
NOESIS_BACKUP_S3_PREFIX=noesis
NOESIS_BACKUP_S3_TIMEOUT_SECONDS=60
# Cifrado solicitado al proveedor S3-compatible en cada copia externa.
NOESIS_BACKUP_S3_SSE=AES256
# Pool acotado de conexiones PostgreSQL por proceso.
NOESIS_DB_POOL_MIN_SIZE=1
NOESIS_DB_POOL_MAX_SIZE=8
NOESIS_DB_POOL_TIMEOUT=10
NOESIS_MAX_JSON_BYTES=262144
NOESIS_MAX_AUDIO_BYTES=12582912
NOESIS_MAX_CHAT_CHARS=4000
# Techo HTTP global, previo al parser de formularios/archivos (20 MiB por defecto).
NOESIS_MAX_REQUEST_BYTES=20971520

# --- Documentos ("papeles": recibos, contratos, fotos de tickets) ---
# Carpeta donde se guardan los archivos subidos. En producción, un volumen
# persistente (igual que la BD). Por defecto ./uploads en la raíz del proyecto.
NOESIS_DOCS_PATH=
# Tamaño máximo por archivo subido, en MB.
NOESIS_MAX_UPLOAD_MB=15
NOESIS_CLAMAV_HOST=
NOESIS_CLAMAV_PORT=3310
NOESIS_CLAMAV_TIMEOUT_SECONDS=8
# Si es true, un fallo del escaner bloquea la subida (recomendado en produccion).
NOESIS_CLAMAV_REQUIRED=false
# Defensa contra imágenes descomprimidas gigantes y PDFs abusivos.
NOESIS_MAX_IMAGE_PIXELS=40000000
NOESIS_MAX_PDF_PAGES=200
# Lectura automática privada de fotos y PDF escaneados. Las dependencias Python
# forman parte del producto; el servidor también debe instalar Tesseract y los
# paquetes cat/spa/eng. Sin runtime, se conserva el documento para revisión manual.
